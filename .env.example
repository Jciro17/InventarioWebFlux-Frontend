# Copia este archivo como .env.local y pon los valores de tu máquina (guía de MessageUcoLab, paso 7).
# Ninguno es secreto: son identificadores y direcciones.

# Aplicación y ambiente de Inventario en MessageUcoLab (los mismos que usa el backend)
VITE_MESSAGEUCOLAB_APPLICATION_ID=
VITE_MESSAGEUCOLAB_ENVIRONMENT_ID=

# Nombre de la aplicación y del ambiente que administra la página Mensajes
VITE_MESSAGEUCOLAB_APPLICATION_NAME=Inventario UCO
VITE_MESSAGEUCOLAB_ENVIRONMENT_NAME=Develop

# Inicio de sesión del componente de seguridad
VITE_SECURITY_LOGIN_URL=http://localhost:5173/login

# Direcciones de los backends (solo si no usas las de por defecto)
# VITE_INVENTARIO_API_URL=http://localhost:8081
# VITE_MESSAGEUCOLAB_URL=http://localhost:8000
